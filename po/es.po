#: data/gtk/window.blp:193
msgid ""
"Query syntax:\n"
"Word-based: Just word or its translation\n"
"E.g. “Mom“, “Dad“\n"
"\n"
"Tag-based: Query starts with “#”, contains tag name FULLY and doesn't "
"contain word-based query\n"
"E.g. “#basic#family”, “#basic #suffixes”\n"
"BUT NOT: “#family mom” or “#famil”"
msgstr ""
"Sintaxis solicitada:\n"
"Basada en palabra: Tan solo palabra o su traducción\n"
"P.e. «Mamá», «Papá»\n"
"\n"
"Basada en etiqueta: Solicitud comienza con “#”, conteniendo nombre "
"etiquetado COMPLETAMENTE y no\n"
"contiene solicitud basada en palabra\n"
"P.e. “#basic#family”, “#basic #suffixes”\n"
"PERO NO: “#family mom” o “#famil”"

